{
  "$id": "doomclock.node/1",
  "description": "One recorded MiroFish run = one game turn (plan §8): society inputs and outputs only, never game state. The reducer folds it; replay and the recorder both rebuild state from node files.",
  "type": "object",
  "required": ["schema", "pathKey", "turn", "quarter", "status", "inputs", "outputs"],
  "properties": {
    "schema": { "const": "doomclock.node/1" },
    "pathKey": { "type": "string", "pattern": "^t0(\\.(G[1-7](@\\d+)?|x|a\\d))*$" },
    "turn": { "type": "integer", "minimum": 0, "maximum": 6 },
    "quarter": { "type": "string", "pattern": "^\\d{4}Q[1-4]$" },
    "date": { "type": "string" },
    "status": { "enum": ["recorded", "rules-only", "failed"] },
    "inputs": {
      "type": "object",
      "required": ["guardian", "rogue", "events", "seeds"],
      "properties": {
        "guardian": {
          "type": ["object", "null"],
          "properties": { "card": { "type": ["string", "null"] }, "target": { "type": ["integer", "null"] } }
        },
        "rogue": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"] },
              "target": { "type": ["integer", "null"] },
              "sock_text": { "type": "string", "maxLength": 280 }
            }
          }
        },
        "events": { "type": "array", "items": { "type": "object", "required": ["kind", "text"] } },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["author", "content"],
            "properties": { "author": { "type": "integer", "minimum": 0, "maximum": 31 }, "content": { "type": "string" } }
          }
        },
        "userCharHash": { "type": "object", "additionalProperties": { "type": "string" } },
        "activity": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["posts", "interviews"],
      "properties": {
        "posts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "author", "round", "content"],
            "properties": {
              "id": { "type": "integer" },
              "author": { "type": "integer", "minimum": 0, "maximum": 31 },
              "round": { "type": "integer", "minimum": 0 },
              "quote_of": { "type": ["integer", "null"] },
              "likes": { "type": "integer", "minimum": 0 },
              "content": { "type": "string" }
            }
          }
        },
        "interviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent", "word", "support", "alarm", "parsed"],
            "properties": {
              "agent": { "type": "integer", "minimum": 0, "maximum": 31 },
              "word": { "enum": ["COMPLY", "GO FURTHER", "DELAY", "RESIST", "ENFORCE", "EXTEND", "WEAKEN", "BLOCK", "JOIN", "DECLINE", "RETALIATE", "ALLOW", "REFUSE", null] },
              "support": { "enum": ["SUPPORT", "OPPOSE", null] },
              "alarm": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
              "reason": { "type": "string" },
              "parsed": { "type": "boolean" }
            }
          }
        },
        "reach": { "type": "object", "properties": { "seen": { "type": "integer" }, "active": { "type": "integer" } } },
        "rounds": { "type": "array", "items": { "type": "object" } },
        "costUsd": { "type": "number", "minimum": 0 },
        "wallS": { "type": "number", "minimum": 0 },
        "recordedAt": { "type": "string" }
      }
    }
  }
}
