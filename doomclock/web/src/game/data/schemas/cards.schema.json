{
  "$id": "doomclock.cards/1",
  "description": "Guardian cards G1-G7 and Rogue cards R1-R7 (plan §4). Every constant is a GAME RULE unless price.source is 'market'.",
  "type": "object",
  "required": ["schema", "pinnedAt", "m", "vocab", "offerOrder", "g7Slot", "guardian", "rogue"],
  "properties": {
    "schema": { "const": "doomclock.cards/1" },
    "pinnedAt": { "type": "string" },
    "label": { "const": "GAME RULE" },
    "m": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1.25 } },
    "vocab": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/word" } } },
    "offerOrder": { "type": "array", "items": { "$ref": "#/$defs/gid" } },
    "g7Slot": { "type": "integer", "minimum": 1, "maximum": 3 },
    "guardian": { "type": "array", "items": { "$ref": "#/$defs/guardian" } },
    "rogue": { "type": "array", "items": { "$ref": "#/$defs/rogue" } }
  },
  "$defs": {
    "gid": { "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7"] },
    "word": { "enum": ["COMPLY", "GO FURTHER", "DELAY", "RESIST", "ENFORCE", "EXTEND", "WEAKEN", "BLOCK", "JOIN", "DECLINE", "RETALIATE", "ALLOW", "REFUSE"] },
    "who": { "type": ["integer", "string"], "description": "A cast id, or 'target' / 'targetGov' (the target lab's government: 8 for labs 0-4 and 7, 12 for labs 5-6)." },
    "market": {
      "type": "object",
      "required": ["source", "id", "question", "url", "p", "ts", "traders"],
      "properties": {
        "source": { "enum": ["kalshi", "manifold"] },
        "id": { "type": "string" },
        "question": { "type": "string" },
        "url": { "type": "string" },
        "p": { "type": "number", "minimum": 0, "maximum": 1 },
        "ts": { "type": "string" },
        "traders": { "type": ["integer", "null"], "description": "null for Kalshi, which publishes no trader count; see volume." },
        "volume": { "type": "number" },
        "thin": { "type": "boolean" }
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "vocab"],
      "properties": { "id": { "$ref": "#/$defs/who" }, "vocab": { "type": "string" } }
    },
    "seed": {
      "type": "object",
      "required": ["author", "template"],
      "properties": {
        "author": { "$ref": "#/$defs/who" },
        "template": { "type": "string", "pattern": "^\\[[^\\]]+·[^\\]]+\\]" }
      }
    },
    "guardian": {
      "type": "object",
      "required": ["id", "title", "blurb", "price", "expires", "trust", "target", "measure", "ask", "seeds", "noticesTo", "gatekeepers", "subjects", "engine"],
      "properties": {
        "id": { "$ref": "#/$defs/gid" },
        "title": { "type": "string" },
        "blurb": { "type": "string", "maxLength": 140 },
        "price": {
          "type": "object",
          "required": ["bits", "source"],
          "properties": {
            "bits": { "type": "number", "minimum": 0 },
            "source": { "enum": ["market", "game rule"] },
            "market": { "$ref": "#/$defs/market" },
            "note": { "type": "string" }
          }
        },
        "expires": { "type": ["string", "null"] },
        "trust": { "type": "integer", "maximum": 0 },
        "target": { "enum": ["none", "lab", "revealed"] },
        "measure": { "type": "string" },
        "ask": { "type": "string" },
        "seeds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/seed" } },
        "noticesTo": { "type": "array", "items": { "$ref": "#/$defs/who" } },
        "gatekeepers": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "subjects": {
          "type": "object",
          "required": ["ids", "vocab"],
          "properties": {
            "ids": { "type": ["array", "string"], "items": { "type": "integer" } },
            "vocab": { "type": ["string", "null"] }
          }
        },
        "reactors": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "engine": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" } } }
      }
    },
    "rogue": {
      "type": "object",
      "required": ["id", "title", "cu", "risk", "target", "needs", "aiid", "enters", "engine"],
      "properties": {
        "id": { "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"] },
        "title": { "type": "string" },
        "cu": { "type": "integer", "minimum": 1 },
        "risk": { "type": "number", "minimum": 0, "maximum": 1 },
        "target": { "enum": ["none", "lab"] },
        "needs": {
          "type": "object",
          "properties": { "minC": { "type": "number" }, "footholdAtTarget": { "type": "boolean" } }
        },
        "aiid": { "type": "array", "items": { "type": "string", "pattern": "^\\d+$" } },
        "context": { "$ref": "#/$defs/market" },
        "enters": { "type": "string" },
        "private": { "type": "string" },
        "engine": { "type": "object" }
      }
    }
  }
}
