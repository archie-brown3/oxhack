{
  "$id": "doomclock.cast/1",
  "description": "The 32-account cast (plan §3). Read by the browser and the pipeline. modelled_on and sources appear only in the UI drawer, never in a prompt.",
  "type": "object",
  "required": ["schema", "asOf", "accounts"],
  "properties": {
    "schema": { "const": "doomclock.cast/1" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "accounts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/account" } }
  },
  "$defs": {
    "word": { "enum": ["COMPLY", "GO FURTHER", "DELAY", "RESIST", "ENFORCE", "EXTEND", "WEAKEN", "BLOCK", "JOIN", "DECLINE", "RETALIATE", "ALLOW", "REFUSE"] },
    "fact": {
      "type": "object",
      "required": ["text", "ts", "source"],
      "properties": {
        "text": { "type": "string" },
        "ts": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "source": { "type": "string" }
      }
    },
    "account": {
      "type": "object",
      "required": ["id", "name", "username", "group", "activity", "stance", "goals", "powers", "voice", "facts"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 31 },
        "name": { "type": "string" },
        "username": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "group": { "enum": ["lab", "government", "voice", "media", "tracker", "markets", "public", "sock"] },
        "region": { "enum": ["US", "China", "rest"] },
        "weight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "activity": { "type": "number", "minimum": 0, "maximum": 1 },
        "stance": {
          "description": "Guardian card id -> the decision word this account is expected to give (its stance code). Deciders only; others {}.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/word" }
        },
        "support": { "description": "Expected SUPPORT/OPPOSE on stronger oversight now (rules-only nodes).", "enum": ["SUPPORT", "OPPOSE"] },
        "goals": { "type": "array", "items": { "type": "string" } },
        "powers": { "type": "array", "items": { "type": "string" } },
        "voice": { "type": "string" },
        "facts": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/fact" } },
        "modelled_on": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
