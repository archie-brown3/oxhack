{
  "name": "doomclock-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "publish:cache": "node scripts/publish-cache.ts",
    "test": "tsc --noEmit -p tsconfig.app.json && node --test src/engine/ src/game/ src/ui/ src/fixtures/contract.test.ts ../pipeline/asof/ ../pipeline/world/",
    "tokens": "node ../../.lavish/prototype/gen-tokens.mjs src/styles/tokens.css && grep -v fonts.googleapis ../../context/design-system/components/bundle.css > src/styles/ds.css"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "globe.gl": "^2.46.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
